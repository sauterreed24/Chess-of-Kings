{
  "name": "chess-of-kings",
  "private": true,
  "version": "0.2.14",
  "description": "The Calculus of Kings — alt-history narrative chess RPG (TypeScript, Vite, PWA).",
  "homepage": "https://sauterreed24.github.io/Chess-of-Kings/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sauterreed24/Chess-of-Kings.git"
  },
  "bugs": {
    "url": "https://github.com/sauterreed24/Chess-of-Kings/issues"
  },
  "keywords": [
    "chess",
    "game",
    "typescript",
    "vite",
    "vitest",
    "pwa",
    "accessibility",
    "github-pages"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --base /Chess-of-Kings/",
    "assets:icon": "node scripts/render-assets-icon.mjs",
    "assets:generate": "npm run assets:icon && npx @capacitor/assets generate --ios --android --iconBackgroundColor \"#0a0908\" --iconBackgroundColorDark \"#080706\" --splashBackgroundColor \"#0a0908\" --splashBackgroundColorDark \"#080706\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deterministic": "vitest run --pool=forks --no-file-parallelism --maxWorkers=1 --sequence.shuffle=false",
    "test:watch": "vitest",
    "test:ui-smoke": "vitest run src/app/rewardOverlayController.test.ts src/app/escapeKeyRouting.test.ts src/app/chronicleEchoTimer.test.ts src/app/uiEscape.smoke.test.ts src/app/mountApp.play.smoke.test.ts",
    "report:bundle-gzip": "node scripts/report-bundle-gzip.mjs",
    "quality:gate": "node scripts/quality-gate.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "chess.js": "^1.4.0"
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.15"
    },
    "replace": {
      "minimatch": "^3.1.5"
    }
  }
}
