{
  "name": "chess-of-kings",
  "private": true,
  "version": "0.2.13",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets:icon": "node scripts/render-assets-icon.mjs",
    "assets:generate": "npm run assets:icon && npx @capacitor/assets generate --ios --android --iconBackgroundColor \"#0a0908\" --iconBackgroundColorDark \"#080706\" --splashBackgroundColor \"#0a0908\" --splashBackgroundColorDark \"#080706\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui-smoke": "vitest run src/app/rewardOverlayController.test.ts src/app/escapeKeyRouting.test.ts src/app/chronicleEchoTimer.test.ts src/app/uiEscape.smoke.test.ts",
    "report:bundle-gzip": "node scripts/report-bundle-gzip.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "chess.js": "^1.4.0"
  }
}
